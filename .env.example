# Cloud execution engine (Claude Code CLI)
# Not required if you're authenticated via `claude login`.
ANTHROPIC_API_KEY=

# Local execution engine (Ollama)
OLLAMA_HOST=http://localhost:11434

# Local reasoning model used by the planning node
AUTOFACTORY_PLAN_MODEL=deepseek-r1:14b

# Local tool-calling model used by OpenCode for self-healing loops
AUTOFACTORY_HEAL_MODEL=hermes3:8b

# Cloud model used by Claude Code CLI for architecture tasks
AUTOFACTORY_ARCHITECT_MODEL=claude-sonnet-5

# Local model used to inspect the architect's diff before running tests
AUTOFACTORY_INSPECT_MODEL=qwen2.5-coder:32b

# Local model used for the advisory security review after tests pass
AUTOFACTORY_SECURITY_MODEL=qwen2.5-coder:32b

# Local model used to triage a test/e2eTest failure: classify it as a quick
# heal, something that needs architect's broader tools/context, or something
# that needs a human — and write instructions for whichever comes next. See
# README for why this is scoped to classification, not full diagnosis.
AUTOFACTORY_TRIAGE_MODEL=deepseek-r1:14b

# Graph execution tuning — unlike the *_MODEL vars above, these are only
# read once, by `autofactory init`, to seed .factory/STATE.json (active_target
# and max_retries). Changing them later has no effect on an already-initialized
# project; use `autofactory init --target ... --max-retries ... --force` instead.
AUTOFACTORY_MAX_RETRIES=3
AUTOFACTORY_TARGET=web

# End-to-end test command, run after unit tests pass. Defaults to
# `npm run test:e2e` if unset. A missing script is treated as "E2E not set
# up yet" (a loud warning, not a blocking failure) rather than forcing every
# project to have E2E before it can finish. See README for the Maestro
# (.maestro/ flows) convention architect uses to implement this script.
AUTOFACTORY_E2E_TEST_COMMAND=npm run test:e2e

# Advisory visual/usability review of E2E screenshots (.factory/e2e-artifacts/)
# against UX_WIREFRAMES.md, via Claude Code CLI's vision — real cloud cost per
# run, so it's opt-in. Leave unset to disable; set to any non-empty value to
# enable.
AUTOFACTORY_ENABLE_VISUAL_REVIEW=

# Deploy command, run after securityCheck, before finalize. AutoFactory has
# no built-in knowledge of any deploy target — it just runs whatever you set
# here (e.g. "eas build --platform all --non-interactive --profile preview").
# Leave unset to disable deploy entirely (default).
AUTOFACTORY_DEPLOY_COMMAND=

# Cloud model used to write/update the target project's README.md, always
# run after deploy, before finalize — not optional, unlike visualReview/
# deploy. Needs real Read access to describe the actual project accurately
# (scripts, structure), hence cloud rather than local. Falls back to
# AUTOFACTORY_ARCHITECT_MODEL if unset.
AUTOFACTORY_README_MODEL=claude-sonnet-5

# Local model used to write the 2-4 sentence narrative summary in
# .factory/REPORT.md (generated at the end of every run, success or
# failure — cost/timing/token numbers in that report come straight from
# STATE.json's logs, not from this model, so a bad summary never corrupts
# the real numbers).
AUTOFACTORY_REPORT_MODEL=deepseek-r1:14b
